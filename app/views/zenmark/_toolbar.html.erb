<div class="zenmark-toolbar flex flex-col bg-slate-50/90 border-b border-slate-200 text-slate-700 select-none">
  <!-- Primary Tool Row: Stays strictly on one line without breaking -->
  <div class="flex items-center justify-between gap-2 px-3 py-1.5 overflow-x-auto min-w-0">
    <!-- Left Side: Formatting Tools -->
    <div class="flex items-center gap-0.5 shrink-0">
    <!-- Group 1: Text Styling -->
    <div class="flex items-center gap-0.5 pr-1.5 mr-1.5 border-r border-slate-200">
      <button type="button" data-action="mousedown->zenmark-editor#preserveSelection click->zenmark-editor#bold" title="Bold (⌘B)" class="zenmark-tool-btn" aria-label="Bold">
        <span class="material-symbols-outlined text-[19px]">format_bold</span>
      </button>
      <button type="button" data-action="mousedown->zenmark-editor#preserveSelection click->zenmark-editor#italic" title="Italic (⌘I)" class="zenmark-tool-btn" aria-label="Italic">
        <span class="material-symbols-outlined text-[19px]">format_italic</span>
      </button>
      <button type="button" data-action="mousedown->zenmark-editor#preserveSelection click->zenmark-editor#strikethrough" title="Strikethrough (⌘⇧X)" class="zenmark-tool-btn" aria-label="Strikethrough">
        <span class="material-symbols-outlined text-[19px]">strikethrough_s</span>
      </button>
      <button type="button" data-action="mousedown->zenmark-editor#preserveSelection click->zenmark-editor#highlight" title="Highlight (==text==)" class="zenmark-tool-btn" aria-label="Highlight">
        <span class="material-symbols-outlined text-[19px]">ink_highlighter</span>
      </button>
      <button type="button" data-action="mousedown->zenmark-editor#preserveSelection click->zenmark-editor#code" title="Code / Code block (⌘⇧C)" class="zenmark-tool-btn" aria-label="Code">
        <span class="material-symbols-outlined text-[19px]">code</span>
      </button>
      <button type="button" data-action="mousedown->zenmark-editor#preserveSelection click->zenmark-editor#toggleCase" title="Toggle Title Case / Sentence Case (selected text or current line)" class="zenmark-tool-btn text-xs font-bold px-1.5" aria-label="Toggle Title Case / Sentence Case">
        Aa
      </button>
    </div>

    <!-- Group 2: Headings & Quotes -->
    <div class="flex items-center gap-0.5 pr-1.5 mr-1.5 border-r border-slate-200">
      <button type="button" data-action="mousedown->zenmark-editor#preserveSelection click->zenmark-editor#heading2" title="Heading 2 (##)" class="zenmark-tool-btn text-xs font-bold px-1.5" aria-label="Heading 2">
        H2
      </button>
      <button type="button" data-action="mousedown->zenmark-editor#preserveSelection click->zenmark-editor#heading3" title="Heading 3 (###)" class="zenmark-tool-btn text-xs font-bold px-1.5" aria-label="Heading 3">
        H3
      </button>
      <button type="button" data-action="mousedown->zenmark-editor#preserveSelection click->zenmark-editor#heading4" title="Heading 4 (####)" class="zenmark-tool-btn text-xs font-bold px-1.5" aria-label="Heading 4">
        H4
      </button>
      <button type="button" data-action="mousedown->zenmark-editor#preserveSelection click->zenmark-editor#blockquote" title="Quote (>)" class="zenmark-tool-btn" aria-label="Blockquote">
        <span class="material-symbols-outlined text-[19px]">format_quote</span>
      </button>
    </div>

    <!-- Group 3: Lists & Structure -->
    <div class="flex items-center gap-0.5 pr-1.5 mr-1.5 border-r border-slate-200">
      <button type="button" data-action="mousedown->zenmark-editor#preserveSelection click->zenmark-editor#unorderedList" title="Bullet List (⌘⇧8)" class="zenmark-tool-btn" aria-label="Bullet List">
        <span class="material-symbols-outlined text-[19px]">format_list_bulleted</span>
      </button>
      <button type="button" data-action="mousedown->zenmark-editor#preserveSelection click->zenmark-editor#orderedList" title="Numbered List (⌘⇧7)" class="zenmark-tool-btn" aria-label="Numbered List">
        <span class="material-symbols-outlined text-[19px]">format_list_numbered</span>
      </button>
      <button type="button" data-action="mousedown->zenmark-editor#preserveSelection click->zenmark-editor#checklist" title="Task List (- [ ])" class="zenmark-tool-btn" aria-label="Task List">
        <span class="material-symbols-outlined text-[19px]">checklist</span>
      </button>
      <button type="button" data-action="mousedown->zenmark-editor#preserveSelection click->zenmark-editor#insertTable" title="Insert Markdown Table" class="zenmark-tool-btn" aria-label="Insert Table">
        <span class="material-symbols-outlined text-[19px]">table_chart</span>
      </button>
      <button type="button" data-action="mousedown->zenmark-editor#preserveSelection click->zenmark-editor#horizontalRule" title="Horizontal Divider (---)" class="zenmark-tool-btn" aria-label="Horizontal Rule">
        <span class="material-symbols-outlined text-[19px]">horizontal_rule</span>
      </button>
    </div>

    <!-- Group 4: Inserts (Link, Image, Diagram) -->
    <div class="flex items-center gap-0.5">
      <button type="button" data-action="click->zenmark-editor#link" title="Insert Link (⌘K)" class="zenmark-tool-btn" aria-label="Link">
        <span class="material-symbols-outlined text-[19px]">link</span>
      </button>
      <button type="button" data-action="click->zenmark-editor#image" title="Upload Image (or paste/drag)" class="zenmark-tool-btn" aria-label="Image">
        <span class="material-symbols-outlined text-[19px]">image</span>
      </button>
      <button type="button" data-action="click->zenmark-editor#openDiagramModal" title="Visual Architecture Diagram (diagram-js)" class="zenmark-tool-btn" aria-label="Draw Diagram">
        <span class="material-symbols-outlined text-[19px]">account_tree</span>
      </button>
    </div>
  </div>

    <!-- Right Side: Save Button, View Modes & Zen Fullscreen -->
    <div class="flex items-center gap-1.5 shrink-0">
      <!-- Context-Aware Save Button (Fixed compact size) -->
      <button type="button"
              data-zenmark-editor-target="saveBtn"
              data-action="mousedown->zenmark-editor#preserveSelection click->zenmark-editor#saveForm"
              title="Save changes (⌘S)"
              class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-semibold text-slate-700 hover:text-slate-900 bg-white hover:bg-slate-100 border border-slate-200/90 shadow-2xs transition-colors cursor-pointer shrink-0">
        <span class="material-symbols-outlined text-[15px] text-slate-500" data-zenmark-editor-target="saveIcon">check</span>
        <span data-zenmark-editor-target="saveLabel">Save</span>
      </button>

      <!-- View Switcher Pills -->
      <div class="inline-flex items-center p-0.5 rounded-lg bg-slate-200/70 border border-slate-200/80 text-xs shrink-0">
        <button type="button" 
                data-zenmark-editor-target="modeWriteBtn"
                data-action="click->zenmark-editor#setWriteMode" 
                class="zenmark-mode-btn active" 
                title="Edit markdown directly">
          <span class="material-symbols-outlined text-[15px]">edit</span>
          <span>Write</span>
        </button>
        <button type="button" 
                data-zenmark-editor-target="modeSplitBtn"
                data-action="click->zenmark-editor#setSplitMode" 
                class="zenmark-mode-btn" 
                title="Side-by-side live editor & preview">
          <span class="material-symbols-outlined text-[15px]">vertical_split</span>
          <span>Split</span>
        </button>
        <button type="button" 
                data-zenmark-editor-target="modePreviewBtn"
                data-action="click->zenmark-editor#setPreviewMode" 
                class="zenmark-mode-btn" 
                title="Full rendered preview">
          <span class="material-symbols-outlined text-[15px]">visibility</span>
          <span>Preview</span>
        </button>
      </div>

      <!-- Zen / Fullscreen Toggle -->
      <button type="button" 
              data-zenmark-editor-target="fullscreenBtn"
              data-action="click->zenmark-editor#toggleFullscreen" 
              title="Distraction-free Zen Mode (Esc to exit)" 
              class="zenmark-tool-btn ml-0.5"
              aria-label="Zen Mode">
        <span class="material-symbols-outlined text-[19px]" data-zenmark-editor-target="fullscreenIcon">fullscreen</span>
      </button>
    </div>
  </div>

  <!-- Dedicated Status Row (New Line for Save / Unsaved Status Updates) -->
  <div class="flex items-center justify-between px-3 py-1 bg-white/75 border-t border-slate-200/70 text-[11px] select-none min-h-[25px]">
    <div class="flex items-center gap-2">
      <!-- Unsaved Indicator Pill (hidden when clean) -->
      <span data-zenmark-editor-target="unsavedBadge" class="hidden">
        <span class="inline-flex items-center gap-1 px-1.5 py-0.5 bg-amber-50 border border-amber-200 text-amber-800 font-semibold rounded-md text-[10px]">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
          <span>Unsaved edits</span>
        </span>
      </span>

      <!-- Autosave / Save Status Indicator -->
      <span data-zenmark-editor-target="autosaveStatus" class="inline-flex items-center gap-1 text-[11px] font-medium text-slate-500">
        <span data-zenmark-editor-target="autosaveTime">All changes saved</span>
      </span>
    </div>

    <!-- Right Helper Text -->
    <div class="text-[10px] text-slate-400 hidden sm:flex items-center gap-2">
      <span>Auto-save active</span>
      <span>•</span>
      <span>⌘S to save</span>
    </div>
  </div>
</div>
