<div class="zenmark-dialog hidden fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-xs flex items-center justify-center p-3 sm:p-5"
     data-zenmark-editor-target="diagramDialog">
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-2xl w-full max-w-6xl h-[88vh] flex flex-col overflow-hidden text-slate-800">

    <!-- Modal Header / Toolbar -->
    <div class="flex flex-wrap items-center justify-between gap-3 px-5 py-3.5 border-b border-slate-200 bg-slate-50/70 shrink-0">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-xl bg-slate-100 border border-slate-200 flex items-center justify-center text-slate-700 shrink-0">
          <span class="material-symbols-outlined text-[18px]">account_tree</span>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h3 class="text-sm font-bold text-slate-900">Visual Architecture Studio</h3>
            <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-md bg-slate-100 border border-slate-200 text-slate-600">diagram-js</span>
          </div>
          <p class="text-[11px] text-slate-500">Drag shapes, double-click to edit labels, and connect nodes with orthogonal arrows</p>
        </div>
      </div>

      <!-- Canvas Controls & Starter Templates -->
      <div class="flex flex-wrap items-center gap-2">
        <!-- Starter Template Selector -->
        <div class="flex items-center gap-1.5 mr-1">
          <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 hidden md:inline">Template:</span>
          <select data-zenmark-editor-target="diagramTemplateSelect"
                  data-action="change->zenmark-editor#loadDiagramTemplate"
                  class="rounded-xl border border-slate-200 px-2.5 py-1.5 text-xs font-medium text-slate-700 bg-white focus:outline-none focus:ring-2 focus:ring-[#C21057]/15 focus:border-[#C21057] shadow-2xs cursor-pointer">
            <option value="three_tier">3-Tier Cloud Architecture</option>
            <option value="event_driven">Event-Driven Microservices</option>
            <option value="rag_pipeline">AI / RAG Pipeline</option>
            <option value="blank">Blank Canvas</option>
          </select>
        </div>

        <!-- Undo / Redo / Zoom Toolbar -->
        <div class="inline-flex items-center rounded-xl border border-slate-200 bg-white p-0.5 shadow-2xs">
          <button type="button"
                  data-action="click->zenmark-editor#diagramUndo"
                  title="Undo (⌘Z)"
                  class="p-1.5 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-colors cursor-pointer">
            <span class="material-symbols-outlined text-[17px] block">undo</span>
          </button>
          <button type="button"
                  data-action="click->zenmark-editor#diagramRedo"
                  title="Redo (⌘⇧Z)"
                  class="p-1.5 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-colors cursor-pointer">
            <span class="material-symbols-outlined text-[17px] block">redo</span>
          </button>
          <span class="w-px h-4 bg-slate-200 mx-0.5"></span>
          <button type="button"
                  data-action="click->zenmark-editor#diagramZoomOut"
                  title="Zoom Out"
                  class="p-1.5 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-colors cursor-pointer">
            <span class="material-symbols-outlined text-[17px] block">remove</span>
          </button>
          <button type="button"
                  data-action="click->zenmark-editor#diagramZoomReset"
                  title="Fit to Viewport"
                  class="px-2 py-1 rounded-lg text-[11px] font-semibold text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-colors cursor-pointer">
            Fit
          </button>
          <button type="button"
                  data-action="click->zenmark-editor#diagramZoomIn"
                  title="Zoom In"
                  class="p-1.5 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-colors cursor-pointer">
            <span class="material-symbols-outlined text-[17px] block">add</span>
          </button>
        </div>

        <button type="button"
                data-action="click->zenmark-editor#closeDiagramModal"
                class="text-slate-400 hover:text-slate-700 rounded-xl p-1.5 hover:bg-slate-100 transition-colors cursor-pointer"
                aria-label="Close diagram studio">
          <span class="material-symbols-outlined text-[20px] block">close</span>
        </button>
      </div>
    </div>

    <!-- Main Studio Body: Left Shape Palette + Center diagram-js Canvas + Right Inspector -->
    <div class="flex-1 flex min-h-0 overflow-hidden">

      <!-- Left Sidebar: Cloud & Architecture Palette -->
      <div class="w-56 border-r border-slate-200 bg-slate-50/50 p-3.5 flex flex-col justify-between overflow-y-auto shrink-0">
        <div class="space-y-4">
          <div>
            <div class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 mb-2">Add Node to Canvas</div>
            <div class="grid grid-cols-1 gap-1.5">
              <button type="button"
                      data-action="click->zenmark-editor#addDiagramNode"
                      data-shape-type="service"
                      data-default-label="Cloud Run Service"
                      data-default-sub="Compute"
                      data-default-theme="slate"
                      class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold text-slate-700 hover:text-slate-900 bg-white hover:bg-slate-100/80 border border-slate-200/90 shadow-2xs transition-all cursor-pointer text-left">
                <span class="w-6 h-6 rounded-lg bg-slate-100 border border-slate-300 flex items-center justify-center text-slate-700 shrink-0">
                  <span class="material-symbols-outlined text-[15px]">dns</span>
                </span>
                <div>
                  <div class="leading-tight">Service / API</div>
                  <div class="text-[10px] font-normal text-slate-400">Compute & microservices</div>
                </div>
              </button>

              <button type="button"
                      data-action="click->zenmark-editor#addDiagramNode"
                      data-shape-type="database"
                      data-default-label="Cloud SQL"
                      data-default-sub="Database"
                      data-default-theme="blue"
                      class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold text-slate-700 hover:text-slate-900 bg-white hover:bg-slate-100/80 border border-slate-200/90 shadow-2xs transition-all cursor-pointer text-left">
                <span class="w-6 h-6 rounded-lg bg-blue-50 border border-blue-200 flex items-center justify-center text-blue-600 shrink-0">
                  <span class="material-symbols-outlined text-[15px]">database</span>
                </span>
                <div>
                  <div class="leading-tight">Database / Store</div>
                  <div class="text-[10px] font-normal text-slate-400">SQL, NoSQL & buckets</div>
                </div>
              </button>

              <button type="button"
                      data-action="click->zenmark-editor#addDiagramNode"
                      data-shape-type="queue"
                      data-default-label="Cloud Pub/Sub"
                      data-default-sub="Event Bus"
                      data-default-theme="amber"
                      class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold text-slate-700 hover:text-slate-900 bg-white hover:bg-slate-100/80 border border-slate-200/90 shadow-2xs transition-all cursor-pointer text-left">
                <span class="w-6 h-6 rounded-lg bg-amber-50 border border-amber-200 flex items-center justify-center text-amber-600 shrink-0">
                  <span class="material-symbols-outlined text-[15px]">swap_horiz</span>
                </span>
                <div>
                  <div class="leading-tight">Queue / Stream</div>
                  <div class="text-[10px] font-normal text-slate-400">Pub/Sub, Kafka & queues</div>
                </div>
              </button>

              <button type="button"
                      data-action="click->zenmark-editor#addDiagramNode"
                      data-shape-type="client"
                      data-default-label="Client / Edge"
                      data-default-sub="External"
                      data-default-theme="rose"
                      class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold text-slate-700 hover:text-slate-900 bg-white hover:bg-slate-100/80 border border-slate-200/90 shadow-2xs transition-all cursor-pointer text-left">
                <span class="w-6 h-6 rounded-lg bg-rose-50 border border-rose-200 flex items-center justify-center text-[#C21057] shrink-0">
                  <span class="material-symbols-outlined text-[15px]">public</span>
                </span>
                <div>
                  <div class="leading-tight">Client / External</div>
                  <div class="text-[10px] font-normal text-slate-400">Users, CDN & external</div>
                </div>
              </button>

              <button type="button"
                      data-action="click->zenmark-editor#addDiagramNode"
                      data-shape-type="gateway"
                      data-default-label="Load Balancer"
                      data-default-sub="Gateway"
                      data-default-theme="emerald"
                      class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold text-slate-700 hover:text-slate-900 bg-white hover:bg-slate-100/80 border border-slate-200/90 shadow-2xs transition-all cursor-pointer text-left">
                <span class="w-6 h-6 rounded-lg bg-emerald-50 border border-emerald-200 flex items-center justify-center text-emerald-600 shrink-0">
                  <span class="material-symbols-outlined text-[15px]">alt_route</span>
                </span>
                <div>
                  <div class="leading-tight">Router / Gateway</div>
                  <div class="text-[10px] font-normal text-slate-400">API Gateway, LB & WAF</div>
                </div>
              </button>

              <button type="button"
                      data-action="click->zenmark-editor#addDiagramNode"
                      data-shape-type="group"
                      data-default-label="VPC / Private Subnet"
                      data-default-sub="Boundary"
                      data-default-theme="slate"
                      class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold text-slate-700 hover:text-slate-900 bg-white hover:bg-slate-100/80 border border-dashed border-slate-300 shadow-2xs transition-all cursor-pointer text-left">
                <span class="w-6 h-6 rounded-lg bg-slate-100 border border-dashed border-slate-400 flex items-center justify-center text-slate-600 shrink-0">
                  <span class="material-symbols-outlined text-[15px]">select_all</span>
                </span>
                <div>
                  <div class="leading-tight">VPC / Zone Box</div>
                  <div class="text-[10px] font-normal text-slate-400">Region or cluster boundary</div>
                </div>
              </button>
            </div>
          </div>

          <!-- Connection Mode Toggle -->
          <div class="pt-3 border-t border-slate-200/80">
            <div class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 mb-2">Connections</div>
            <button type="button"
                    data-zenmark-editor-target="diagramConnectModeBtn"
                    data-action="click->zenmark-editor#startDiagramConnectMode"
                    class="w-full flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl text-xs font-semibold text-slate-700 hover:text-slate-900 bg-white hover:bg-slate-100 border border-slate-200 shadow-2xs transition-all cursor-pointer">
              <span class="material-symbols-outlined text-[16px] text-[#C21057]">trending_flat</span>
              <span data-zenmark-editor-target="diagramConnectModeLabel">Connect Two Nodes</span>
            </button>
            <p class="text-[10px] text-slate-400 mt-1.5 leading-relaxed">
              Tip: Select any node and click its arrow handle, or click "Connect Two Nodes" then click source → target.
            </p>
          </div>
        </div>

        <!-- Clear Canvas -->
        <div class="pt-3 border-t border-slate-200/80">
          <button type="button"
                  data-action="click->zenmark-editor#clearDiagramCanvas"
                  class="w-full inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold text-rose-600 hover:text-rose-700 hover:bg-rose-50 border border-transparent hover:border-rose-200 transition-colors cursor-pointer">
            <span class="material-symbols-outlined text-[15px]">delete_sweep</span>
            <span>Clear Canvas</span>
          </button>
        </div>
      </div>

      <!-- Center: Interactive diagram-js Canvas -->
      <div class="flex-1 relative bg-slate-50 overflow-hidden"
           style="background-image: radial-gradient(#cbd5e1 1px, transparent 1px); background-size: 20px 20px;">
        <div data-zenmark-editor-target="diagramCanvas"
             class="w-full h-full"></div>

        <!-- Floating Connect Mode Hint Banner -->
        <div data-zenmark-editor-target="diagramConnectHint"
             class="hidden absolute top-3 left-1/2 -translate-x-1/2 z-20 px-3.5 py-1.5 rounded-full bg-slate-900 text-white text-xs font-semibold shadow-lg flex items-center gap-2">
          <span class="material-symbols-outlined text-[15px] text-amber-400">touch_app</span>
          <span data-zenmark-editor-target="diagramConnectHintText">Click source node, then click target node to connect (Esc to cancel)</span>
        </div>
      </div>

      <!-- Right Sidebar: Selected Element Properties Inspector -->
      <div class="w-64 border-l border-slate-200 bg-white p-4 overflow-y-auto shrink-0 flex flex-col justify-between">
        <div class="space-y-4">
          <div>
            <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-400 mb-1.5">Diagram Title / Alt Text</label>
            <input type="text"
                   data-zenmark-editor-target="diagramTitle"
                   value="Cloud Architecture Diagram"
                   placeholder="e.g. Cloud Run Microservices"
                   class="w-full rounded-xl border border-slate-200 px-3 py-2 text-xs font-medium text-slate-800 bg-white focus:outline-none focus:ring-2 focus:ring-[#C21057]/15 focus:border-[#C21057] shadow-2xs" />
          </div>

          <div class="pt-3 border-t border-slate-100">
            <div class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 mb-2">Selected Element</div>

            <!-- Empty Selection State -->
            <div data-zenmark-editor-target="diagramNoSelection" class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/80 text-xs text-slate-500 leading-relaxed">
              Click any shape or arrow on the canvas to customize its label, category tag, or color theme.
            </div>

            <!-- Active Selection Inspector -->
            <div data-zenmark-editor-target="diagramInspector" class="hidden space-y-3">
              <div>
                <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-500 mb-1">Primary Label</label>
                <input type="text"
                       data-zenmark-editor-target="diagramNodeLabel"
                       data-action="input->zenmark-editor#updateSelectedDiagramElement"
                       placeholder="e.g. Cloud SQL Primary"
                       class="w-full rounded-xl border border-slate-200 px-3 py-1.5 text-xs font-medium text-slate-800 bg-white focus:outline-none focus:ring-2 focus:ring-[#C21057]/15 focus:border-[#C21057] shadow-2xs" />
              </div>

              <div data-zenmark-editor-target="diagramNodeSubWrapper">
                <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-500 mb-1">Category / Tech Subtitle</label>
                <input type="text"
                       data-zenmark-editor-target="diagramNodeSub"
                       data-action="input->zenmark-editor#updateSelectedDiagramElement"
                       placeholder="e.g. PostgreSQL 16"
                       class="w-full rounded-xl border border-slate-200 px-3 py-1.5 text-xs font-medium text-slate-800 bg-white focus:outline-none focus:ring-2 focus:ring-[#C21057]/15 focus:border-[#C21057] shadow-2xs" />
              </div>

              <div data-zenmark-editor-target="diagramNodeThemeWrapper">
                <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Color Theme</label>
                <div class="flex items-center gap-1.5">
                  <button type="button" data-action="click->zenmark-editor#setDiagramElementTheme" data-theme="slate" title="Slate" class="w-6 h-6 rounded-lg bg-slate-200 border-2 border-slate-500 cursor-pointer hover:scale-105 transition-transform"></button>
                  <button type="button" data-action="click->zenmark-editor#setDiagramElementTheme" data-theme="blue" title="Blue" class="w-6 h-6 rounded-lg bg-blue-100 border-2 border-blue-600 cursor-pointer hover:scale-105 transition-transform"></button>
                  <button type="button" data-action="click->zenmark-editor#setDiagramElementTheme" data-theme="emerald" title="Emerald" class="w-6 h-6 rounded-lg bg-emerald-100 border-2 border-emerald-600 cursor-pointer hover:scale-105 transition-transform"></button>
                  <button type="button" data-action="click->zenmark-editor#setDiagramElementTheme" data-theme="amber" title="Amber" class="w-6 h-6 rounded-lg bg-amber-100 border-2 border-amber-600 cursor-pointer hover:scale-105 transition-transform"></button>
                  <button type="button" data-action="click->zenmark-editor#setDiagramElementTheme" data-theme="rose" title="Rose / Brand" class="w-6 h-6 rounded-lg bg-rose-100 border-2 border-[#C21057] cursor-pointer hover:scale-105 transition-transform"></button>
                </div>
              </div>

              <div class="pt-2 flex items-center gap-2">
                <button type="button"
                        data-action="click->zenmark-editor#duplicateSelectedDiagramElement"
                        class="flex-1 inline-flex items-center justify-center gap-1 px-2.5 py-1.5 rounded-xl text-xs font-semibold text-slate-700 hover:text-slate-900 bg-white hover:bg-slate-50 border border-slate-200 shadow-2xs transition-colors cursor-pointer">
                  <span class="material-symbols-outlined text-[15px]">content_copy</span>
                  <span>Duplicate</span>
                </button>
                <button type="button"
                        data-action="click->zenmark-editor#deleteSelectedDiagramElement"
                        class="flex-1 inline-flex items-center justify-center gap-1 px-2.5 py-1.5 rounded-xl text-xs font-semibold text-rose-600 hover:text-rose-700 bg-rose-50/60 hover:bg-rose-50 border border-rose-200 shadow-2xs transition-colors cursor-pointer">
                  <span class="material-symbols-outlined text-[15px]">delete</span>
                  <span>Delete</span>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Keyboard Hints -->
        <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 text-[11px] text-slate-500 space-y-1">
          <div class="font-semibold text-slate-700">Shortcuts</div>
          <div>• <strong>Drag</strong> nodes & bendpoints</div>
          <div>• <strong>Click arrow handle</strong> on selected node to connect</div>
          <div>• <strong>Delete / Backspace</strong> removes selection</div>
        </div>
      </div>
    </div>

    <!-- Modal Footer -->
    <div class="flex items-center justify-between px-5 py-3.5 border-t border-slate-200 bg-slate-50/70 shrink-0">
      <div class="text-xs text-slate-500" data-zenmark-editor-target="diagramStatusText">
        Ready · Powered by diagram-js (MIT)
      </div>

      <div class="flex items-center gap-2.5">
        <button type="button"
                data-action="click->zenmark-editor#closeDiagramModal"
                class="inline-flex items-center px-4 py-2 rounded-xl text-xs font-semibold text-slate-700 hover:text-slate-900 bg-white hover:bg-slate-50 border border-slate-200 shadow-2xs transition-colors cursor-pointer">
          Cancel
        </button>
        <button type="button"
                data-zenmark-editor-target="diagramInsertBtn"
                data-action="click->zenmark-editor#insertDiagramIntoMarkdown"
                class="inline-flex items-center justify-center gap-1.5 px-5 py-2 rounded-xl font-semibold text-xs bg-[#C21057] hover:bg-[#a80e4b] text-white shadow-xs transition-colors cursor-pointer">
          <span class="material-symbols-outlined text-[16px]">add_photo_alternate</span>
          <span data-zenmark-editor-target="diagramInsertLabel">Insert Diagram</span>
        </button>
      </div>
    </div>

  </div>
</div>

