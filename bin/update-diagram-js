#!/usr/bin/env bash
# Updates the vendored diagram-js bundle (app/javascript/diagram_js_vendor.js)
# Usage:
#   ./bin/update-diagram-js           # installs latest diagram-js
#   ./bin/update-diagram-js 15.4.0    # installs specific diagram-js version

set -e

VERSION="${1:-latest}"
GEM_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
WORK_DIR="$(mktemp -d "${TMPDIR:-/tmp}/zenmark-diagram-js.XXXXXX")"

cleanup() {
  rm -rf "$WORK_DIR"
}
trap cleanup EXIT

echo "==> Preparing temporary build directory in $WORK_DIR..."
cd "$WORK_DIR"
npm init -y > /dev/null

echo "==> Installing diagram-js@$VERSION, tiny-svg, min-dom, min-dash, and esbuild..."
npm install "diagram-js@$VERSION" tiny-svg min-dom min-dash esbuild

cat << 'EOF' > "$WORK_DIR/vendor_entry.js"
export { default as Diagram } from 'diagram-js';
export { default as ModelingModule } from 'diagram-js/lib/features/modeling/index.js';
export { default as MoveModule } from 'diagram-js/lib/features/move/index.js';
export { default as SelectionModule } from 'diagram-js/lib/features/selection/index.js';
export { default as ConnectModule } from 'diagram-js/lib/features/connect/index.js';
export { default as CreateModule } from 'diagram-js/lib/features/create/index.js';
export { default as BendpointsModule } from 'diagram-js/lib/features/bendpoints/index.js';
export { default as ResizeModule } from 'diagram-js/lib/features/resize/index.js';
export { default as SnappingModule } from 'diagram-js/lib/features/snapping/index.js';
export { default as GridSnappingModule } from 'diagram-js/lib/features/grid-snapping/index.js';
export { default as KeyboardModule } from 'diagram-js/lib/features/keyboard/index.js';
export { default as KeyboardMoveSelectionModule } from 'diagram-js/lib/features/keyboard-move-selection/index.js';
export { default as OutlineModule } from 'diagram-js/lib/features/outline/index.js';
export { default as ContextPadModule } from 'diagram-js/lib/features/context-pad/index.js';
export { default as RulesModule } from 'diagram-js/lib/features/rules/index.js';
export { default as ZoomScrollModule } from 'diagram-js/lib/navigation/zoomscroll/index.js';
export { default as MoveCanvasModule } from 'diagram-js/lib/navigation/movecanvas/index.js';

export { default as BaseRenderer } from 'diagram-js/lib/draw/BaseRenderer.js';
export { componentsToPath } from 'diagram-js/lib/util/RenderUtil.js';
export { default as BaseLayouter } from 'diagram-js/lib/layout/BaseLayouter.js';
export { default as RuleProvider } from 'diagram-js/lib/features/rules/RuleProvider.js';
export { repairConnection } from 'diagram-js/lib/layout/ManhattanLayout.js';
export { getMid } from 'diagram-js/lib/layout/LayoutUtil.js';

export {
  append as svgAppend,
  attr as svgAttr,
  create as svgCreate
} from 'tiny-svg';
EOF

INSTALLED_VER="$(node -p "require('./node_modules/diagram-js/package.json').version")"
echo "==> Bundling diagram-js v$INSTALLED_VER into app/javascript/diagram_js_vendor.js..."

./node_modules/.bin/esbuild "$WORK_DIR/vendor_entry.js" \
  --bundle \
  --format=esm \
  --minify-whitespace \
  --minify-syntax \
  --banner:js="/* diagram-js v${INSTALLED_VER} (MIT) - generated by bin/update-diagram-js */" \
  --outfile="$GEM_ROOT/app/javascript/diagram_js_vendor.js"

echo "==> Done! Updated app/javascript/diagram_js_vendor.js (diagram-js v$INSTALLED_VER)."
